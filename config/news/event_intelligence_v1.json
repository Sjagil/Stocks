{
  "schema": "news_event_intelligence_policy_v1",
  "lookback_days": 30,
  "story_window_hours": 72,
  "near_duplicate_threshold": 0.72,
  "materiality_threshold": 0.22,
  "source_quality": {
    "OFFICIAL_STRUCTURED_SOURCE": 1.0,
    "SEC": 1.0,
    "OFFICIAL_PUBLIC_RSS": 0.95,
    "IBKR_BROKER_NEWS": 0.9,
    "DOW JONES": 0.92,
    "BENZINGA": 0.88,
    "EODHD": 0.82,
    "DATASCRAPER_FORWARD_RSS": 0.68,
    "PUBLIC_RSS_OR_AGGREGATOR": 0.62,
    "DEFAULT": 0.55
  },
  "event_classes": {
    "EARNINGS": {"terms": ["earnings", "eps", "quarterly results"], "severity": 0.65},
    "GUIDANCE_RAISE": {"terms": ["raises guidance", "raised guidance", "raises outlook", "boosts forecast"], "severity": 0.82},
    "GUIDANCE_CUT": {"terms": ["cuts guidance", "cut guidance", "lowers outlook", "profit warning"], "severity": 0.9},
    "MARGIN_PRESSURE": {"terms": ["margin pressure", "margin compression", "cost pressure"], "severity": 0.72},
    "ANALYST_UPGRADE": {"terms": ["upgrade", "raises price target", "price target raised"], "severity": 0.48},
    "ANALYST_DOWNGRADE": {"terms": ["downgrade", "cuts price target", "price target cut"], "severity": 0.55},
    "MERGER_OR_ACQUISITION": {"terms": ["acquisition", "acquire", "merger", "takeover"], "severity": 0.85},
    "CONTRACT_OR_AWARD": {"terms": ["contract award", "wins contract", "awarded contract", "order backlog"], "severity": 0.66},
    "PRODUCT_OR_LAUNCH": {"terms": ["product launch", "launches", "unveils", "approval"], "severity": 0.5},
    "REGULATORY_OR_FDA": {"terms": ["fda", "regulator", "regulatory", "antitrust"], "severity": 0.78},
    "LITIGATION": {"terms": ["lawsuit", "litigation", "court ruling"], "severity": 0.7},
    "CYBERSECURITY": {"terms": ["cyberattack", "cybersecurity", "data breach", "ransomware"], "severity": 0.86},
    "MANAGEMENT_CHANGE": {"terms": ["ceo resigns", "cfo resigns", "appoints ceo", "management change"], "severity": 0.68},
    "LAYOFF_OR_RESTRUCTURING": {"terms": ["layoff", "job cuts", "restructuring"], "severity": 0.62},
    "BANKRUPTCY_OR_DEFAULT": {"terms": ["bankruptcy", "chapter 11", "default"], "severity": 1.0},
    "FRAUD_OR_ACCOUNTING": {"terms": ["fraud", "accounting issue", "restatement", "sec investigation"], "severity": 0.98},
    "GOING_CONCERN": {"terms": ["going concern"], "severity": 1.0},
    "TRADING_HALT": {"terms": ["trading halt", "halted trading"], "severity": 0.95},
    "DIVIDEND_OR_BUYBACK": {"terms": ["dividend", "share buyback", "repurchase"], "severity": 0.45},
    "INSIDER_OR_OWNERSHIP": {"terms": ["insider buy", "insider sale", "13d", "13g", "beneficial ownership"], "severity": 0.58},
    "RATE_OR_CENTRAL_BANK": {"terms": ["fed", "fomc", "ecb", "rate decision", "interest rate"], "severity": 0.82},
    "INFLATION": {"terms": ["inflation", "cpi", "pce"], "severity": 0.78},
    "LABOR_MARKET": {"terms": ["payroll", "jobs report", "unemployment"], "severity": 0.7},
    "PMI_OR_GROWTH": {"terms": ["pmi", "gdp", "industrial production"], "severity": 0.64},
    "GEOPOLITICAL_OR_SANCTIONS": {"terms": ["sanctions", "war", "military escalation", "export ban", "tariff"], "severity": 0.86},
    "SUPPLY_DISRUPTION": {"terms": ["mine closure", "refinery outage", "pipeline outage", "shipping disruption", "strike"], "severity": 0.84},
    "COMMODITY_INVENTORY": {"terms": ["inventory", "stockpiles", "eia report"], "severity": 0.62},
    "OPEC_OR_ENERGY_POLICY": {"terms": ["opec", "production cut", "production increase"], "severity": 0.82},
    "NUCLEAR_OR_URANIUM": {"terms": ["uranium", "nuclear reactor", "nuclear power", "haleu"], "severity": 0.7}
  }
}
