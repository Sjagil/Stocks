# ============================================================
# IBKR TWS PAPER / READ-ONLY BOOTSTRAP
# Kopieer naar .env.ibkr. Zet hier nooit een wachtwoord in.
# TWS verzorgt zelf de interactieve login.
# ============================================================

APP_ENV=development

# Alleen lokale verbindingen toestaan.
IBKR_HOST=127.0.0.1

# TWS paper = 7497
# IB Gateway paper = 4002
# Fase 0 weigert livepoorten 7496 en 4001.
IBKR_PORT=7497

# Uniek per gelijktijdig verbonden API-proces.
IBKR_CLIENT_ID=17

# Leeg laten totdat accountselectie expliciet is ingebouwd.
IBKR_ACCOUNT=

# Fase 0 is hard read-only.
IBKR_READ_ONLY=true
IBKR_ORDER_AUTHORITY=NONE
IBKR_LIVE_TRADING_ENABLED=false
IBKR_ALLOW_ORDER_TRANSMISSION=false

# 1 = live, 2 = frozen, 3 = delayed, 4 = delayed-frozen.
# Gebruik 3 tijdens ontwikkeling als live abonnementen ontbreken.
IBKR_MARKET_DATA_TYPE=3

# Beperkingen voor de latere brokeradapter.
IBKR_ALLOWED_SECURITY_TYPES=STK,FUT
IBKR_ALLOWED_CURRENCIES=EUR,USD
IBKR_MAX_ORDER_NOTIONAL_EUR=0
IBKR_MAX_OPEN_ORDERS=0
IBKR_MAX_POSITIONS=0

# Timeouts.
IBKR_CONNECT_TIMEOUT_SECONDS=12
IBKR_REQUEST_TIMEOUT_SECONDS=15
IBKR_HEARTBEAT_INTERVAL_SECONDS=25
IBKR_STALE_AFTER_SECONDS=45
IBKR_MAX_RECONNECT_ATTEMPTS=5
IBKR_RECONNECT_DELAYS_SECONDS=2,5,15,30

# Lokale output.
IBKR_OUTPUT_DIR=output/ibkr
IBKR_LOG_LEVEL=INFO
