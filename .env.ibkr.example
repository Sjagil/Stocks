# ============================================================
# IBKR TWS PAPER / READ-ONLY BOOTSTRAP
# Kopieer naar .env.ibkr. Zet hier nooit een wachtwoord in.
# TWS verzorgt zelf de interactieve login.
# ============================================================

APP_ENV=development

# Alleen lokale verbindingen toestaan.
IBKR_HOST=127.0.0.1

# TWS paper = 7497
# IB Gateway paper = 4002
# Fase 0 weigert livepoorten 7496 en 4001.
IBKR_PORT=7497

# Uniek per gelijktijdig verbonden API-proces.
IBKR_CLIENT_ID=17

# Leeg laten totdat accountselectie expliciet is ingebouwd.
IBKR_ACCOUNT=

# Fase 0 is hard read-only.
IBKR_READ_ONLY=true
IBKR_ORDER_AUTHORITY=NONE
IBKR_LIVE_TRADING_ENABLED=false
IBKR_ALLOW_ORDER_TRANSMISSION=false

# 1 = live, 2 = frozen, 3 = delayed, 4 = delayed-frozen.
# Gebruik 3 tijdens ontwikkeling als live abonnementen ontbreken.
IBKR_MARKET_DATA_TYPE=3

# Beperkingen voor de latere brokeradapter.
IBKR_ALLOWED_SECURITY_TYPES=STK
IBKR_ALLOWED_CURRENCIES=EUR,USD
IBKR_MAX_ORDER_NOTIONAL_EUR=0
IBKR_MAX_OPEN_ORDERS=0
IBKR_MAX_POSITIONS=0

# Timeouts.
IBKR_CONNECT_TIMEOUT_SECONDS=12
IBKR_REQUEST_TIMEOUT_SECONDS=15
IBKR_HEARTBEAT_INTERVAL_SECONDS=25
IBKR_STALE_AFTER_SECONDS=45
IBKR_MAX_RECONNECT_ATTEMPTS=5
IBKR_RECONNECT_DELAYS_SECONDS=2,5,15,30

# Lokale output.
IBKR_OUTPUT_DIR=output/ibkr
IBKR_LOG_LEVEL=INFO

# Phase 8 read-only broker observation. Gebruik een uniek niet-nul client-id,
# verschillend van IBKR_CLIENT_ID. De fingerprint key blijft lokaal geheim.
IBKR_RECON_CLIENT_ID=817
IBKR_ACCOUNT_FINGERPRINT_KEY=change-me-local-hmac-key
IBKR_RECON_REQUEST_TIMEOUT_SECONDS=15
IBKR_RECON_COMMISSION_GRACE_SECONDS=2
IBKR_RECON_SNAPSHOT_STABILITY_DELAY_SECONDS=1

# Phase 9 manual-only TWS Paper writer. Activeer alleen voor de dedicated
# paper-canaryroute na Phase 8/8.1-observatie. Gebruik nooit raw account-ID's.
IBKR_PAPER_WRITER_CLIENT_ID=917
IBKR_PAPER_WRITER_ENABLED=true
IBKR_PAPER_ACCOUNT_FINGERPRINT=<EXACTE_PHASE8_ACCOUNT_FINGERPRINT>
IBKR_PAPER_MAX_ORDER_NOTIONAL_EUR=100
IBKR_PAPER_MAX_OPEN_ORDERS=1
IBKR_PAPER_MAX_POSITIONS=1
IBKR_PAPER_MAX_NEW_ORDERS_PER_DAY=1
IBKR_PAPER_MAX_CLOSING_ORDERS_PER_DAY=1
IBKR_PAPER_APPROVAL_TTL_SECONDS=300
IBKR_PAPER_CALLBACK_TIMEOUT_SECONDS=15
IBKR_PAPER_RECONCILIATION_TIMEOUT_SECONDS=30

# Phase 10 autonomous Shariah paper foundation. Runtime authority remains
# disabled until Phase 9, financial-finalist, and forward-shadow gates are GO.
IBKR_AUTO_PAPER_ENABLED=false
IBKR_AUTO_PAPER_CLIENT_ID=1017
IBKR_AUTO_PAPER_STRATEGY_ALLOWLIST=
IBKR_AUTO_PAPER_PRODUCT_ALLOWLIST=
IBKR_AUTO_PAPER_MAX_ORDER_NOTIONAL_EUR=50
IBKR_AUTO_PAPER_MAX_NEW_POSITIONS_PER_DAY=1
IBKR_AUTO_PAPER_MAX_CLOSING_ORDERS_PER_DAY=4
IBKR_AUTO_PAPER_MAX_OPEN_POSITIONS=2
IBKR_AUTO_PAPER_MAX_PORTFOLIO_EXPOSURE_EUR=100
IBKR_AUTO_PAPER_MAX_DAILY_LOSS_EUR=20
IBKR_AUTO_PAPER_MAX_SECTOR_EXPOSURE_PCT=25
IBKR_AUTO_PAPER_MAX_EVENT_CLUSTER_EXPOSURE_PCT=15
IBKR_AUTO_PAPER_MAX_SIGNAL_AGE_SECONDS=300
IBKR_AUTO_PAPER_MAX_QUOTE_AGE_SECONDS=15
IBKR_AUTO_PAPER_MAX_SPREAD_BPS=40
IBKR_AUTO_PAPER_RTH_ONLY=true
IBKR_AUTO_PAPER_LIMIT_ONLY=true
IBKR_AUTO_PAPER_REQUIRE_SHARIAH_FRESH=true
IBKR_AUTO_PAPER_HEARTBEAT_TIMEOUT_SECONDS=30
IBKR_AUTO_PAPER_SCHEDULER_INTERVAL_SECONDS=60
